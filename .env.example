# ========================================
# CONFIGURACIÓN DEL SISTEMA SIVIGILA
# ========================================

# Modo de operación: LOCAL, DRIVE o HIBRIDO
APP_MODE=LOCAL

# ========================================
# DIRECTORIOS LOCALES
# ========================================
INPUT_DIR=data/ENTRADA_SIVIGILA
OUTPUT_DIR=data/DEPURADO
ERROR_DIR=data/ERROR
LOG_FILE=logs/sistema.log
RESPALDO_DIR=data/RESPALDOS

# ========================================
# CONFIGURACIÓN DE PROCESAMIENTO
# ========================================

# Filtrar solo departamento de Risaralda
FILTER_ONLY_RISARALDA=False

# Eliminar archivo original después de procesar exitosamente
DELETE_ORIGINAL_AFTER_PROCESS=False

# Dividir archivos con múltiples eventos
SPLIT_MIXED_EVENTS=True

# Procesar todas las hojas de Excel o solo la principal
PROCESS_ALL_SHEETS=False

# Formato de salida: xlsx, csv o ambos
OUTPUT_FORMAT=xlsx

# ========================================
# GOOGLE DRIVE (solo si APP_MODE=DRIVE o HIBRIDO)
# ========================================

# Ruta a las credenciales de Google
# Puede ser OAuth client o service account.
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials/credentials.json

# Ruta donde se almacenará el token (generado automáticamente)
# Con service account este archivo no es necesario, pero se deja por compatibilidad.
GOOGLE_DRIVE_TOKEN_PATH=credentials/token.json

# ID de carpeta de entrada en Google Drive
GOOGLE_DRIVE_INPUT_FOLDER_ID=1mPh5ml7lJpLiFbQtEt-_R1YdUhSV_zjJ

# ID de carpeta de salida (depurado) en Google Drive
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=1-5-RMkqlyH4heFitiFp130oO7DFXkPky

# ID de carpeta de errores en Google Drive
GOOGLE_DRIVE_ERROR_FOLDER_ID=

# Nota importante:
# Una service account puede leer archivos/carpetas compartidos en My Drive,
# pero para CREAR archivos suele requerir un Shared Drive o delegación OAuth
# de un usuario con cuota de almacenamiento.

# ========================================
# GOOGLE SHEETS (lectura nativa)
# ========================================

GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/credentials.json
EPIDEMIOLOGOS_SPREADSHEET_ID=1mdP0J5avq4tROUiNVe8zfxKiqSU_qG05QvxNDlcCMeE
EPIDEMIOLOGOS_SHEET_NAME=Epidemiologos

# ========================================
# APPS SCRIPT (HISTORICO INTERANUAL)
# ========================================

# URL de despliegue de Apps Script (mismo DEPLOY_ID del bridge)
APPS_SCRIPT_DEPLOY_URL=https://script.google.com/macros/s/AKfycbx6lFYxQtS0sUOIw3713SH5NSwatq-4vYf_eHiedqk3cJgQN_vgzd7rFa1Om-VqLGpd/exec

# API key del bridge (si tu script la valida)
APPS_SCRIPT_API_KEY=123456

# Timeout de llamadas a Apps Script (segundos)
APPS_SCRIPT_TIMEOUT_SECONDS=20

# ========================================
# APPS SCRIPT (LECTURA BOLETIN CASOS 2)
# ========================================

# URL del Web App desplegado desde apps_script_boletin_casos2.gs
BULLETIN_APPS_SCRIPT_URL=

# API key para consumir el Web App del boletín
# Si no configuras Script Properties, el Apps Script usa por defecto: 123456
BULLETIN_APPS_SCRIPT_API_KEY=123456

# Timeout del cliente del boletín (segundos)
BULLETIN_APPS_SCRIPT_TIMEOUT_SECONDS=20

# Configuración nativa del sheet CASOS 2
BULLETIN_SPREADSHEET_ID=1t41_VO9SyIy6N2at-Q0kh7DXGpg-iCMZPDpmLLSN-PM
BULLETIN_SHEET_NAME=CASOS 2
BULLETIN_EVENT_CODE=549
BULLETIN_TIMEZONE=America/Bogota
BULLETIN_TREAT_TRAILING_ZEROS_AS_MISSING=True
HISTORICO_549_SPREADSHEET_ID=1t41_VO9SyIy6N2at-Q0kh7DXGpg-iCMZPDpmLLSN-PM
HISTORICO_549_SHEET_NAME=CASOS 2

# Gmail API opcional. Requiere Google Workspace con domain-wide delegation.
GOOGLE_GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GOOGLE_GMAIL_DELEGATED_USER=
GOOGLE_GMAIL_FROM=

# ========================================
# FUNCIONALIDADES OPCIONALES
# ========================================

# Generar boletín epidemiológico después del procesamiento
ENABLE_BOLETIN=False

# Generar mapa interactivo en el dashboard
ENABLE_MAP=True

# Monitoreo automático de carpeta de entrada
ENABLE_MONITOR=False

# Intervalo de monitoreo en segundos
MONITOR_INTERVAL=30

# ========================================
# LOGGING
# ========================================

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# STREAMLIT
# ========================================

# Puerto para el dashboard
STREAMLIT_PORT=8501

# Theme para Streamlit: light o dark
STREAMLIT_THEME=light
